# Website scratch JS (the `tesmp` file was an unfinished refactor of home.js)
Beyond-the-Stats/Website/static/tesmp

# =============================================================================
# Pipeline data (regenerated each run)
#
# - Raw_Data        : downloaded by Download_Latest_Data.py
# - Processed_Data  : derived by Process_Data.py
# - Team_Data       : derived team stats + 4 GB trained model_cache.pkl
# - Predictions     : regenerated by the daily pipeline
# - National_Team_Data caches: ESPN scoreboard + Transfermarkt HTML
# - Website/files/accuracy_*: regenerated daily
# =============================================================================

# Raw league data
**/Data/Raw_Data/**
**/Data/Processed_Data/**

# Trained-model bundle + derived team stats
**/Data/Team_Data/**

# Legacy prediction outputs (pre-reorg); keep ignored if any remain
**/Data/Predictions/**

# Player event stats (goals/assists/cards per competition, accumulated each run)
**/Data/PlayerStats/**

# ESPN scoreboard response cache
**/Data/National_Team_Data/espn_scoreboard_cache/**

# Transfermarkt HTML response cache
**/Data/National_Team_Data/transfermarkt_cache/**

# National team trained model bundle
**/Data/National_Team_Data/national_team_model_cache.pkl

# Trained model bundles
**/Data/Team_Data/model_cache.pkl
**/pipelines/*/Data/Team_Data/model_cache.pkl

# Player market-value seed (regenerated by the pipeline)
**/pipelines/*/Data/Team_Data/team_top_market_value_players.json
**/pipelines/*/Data/Team_Data/mls_squad_values.json

# All generated artifacts (predictions, LeagueData, CupData, status, logs, cache)
**/Output/**

# ESPN API response cache (legacy location under Data/)
**/Data/ApiCache/**

# Legacy runtime state under Data/ (now under Output/Status/)
**/Data/last_refresh.json
**/Data/pipeline_status.json
**/Data/standings_cache.json
**/Data/prediction_tracking.json
**/Data/live_score_history.json
**/Data/live_score_history.json.lock
**/Data/backend_run_status.json
**/Data/Status/**

# Regenerated national-team output data (downloaded/processed each run)
**/Data/National_Team_Data/national_team_matches_processed.csv
**/Data/National_Team_Data/national_team_matches_raw.csv
**/Data/National_Team_Data/national_team_recent_context.csv
**/Data/National_Team_Data/national_team_recent_matches_raw.csv
**/Data/National_Team_Data/national_team_squad_values.json

# Website accuracy history (regenerated daily)
Beyond-the-Stats/Website/files/accuracy_history/**
Beyond-the-Stats/Website/files/accuracy_totals.json
Beyond-the-Stats/Website/tmp_test_api.py

# Old files (snapshots from prior commits)
old_app_*.py
old_index_*.html

# User feedback submissions (runtime data, not source)
Beyond-the-Stats/Website/files/feedback/feedback.txt

# Latest pipeline terminal capture (served via /api/pipeline/logs)
Beyond-the-Stats/Output/Logs/pipeline_latest.log
Beyond-the-Stats/Data/pipeline_latest.log

# =============================================================================
# EXCEPTIONS — keep team mappings, FIFA rankings, and pipeline seeds
# =============================================================================

# Region-local mapping masters (still under pipeline Data/Predictions)
!Beyond-the-Stats/pipelines/mls/Data/Predictions/team_name_mapping_master.json
!Beyond-the-Stats/pipelines/extra/Data/Predictions/team_name_mapping_master.json
!Data/team_name_mapping_master.json
# Season roster / ESPN name seeds (tracked under Data/Seeds/)
!Beyond-the-Stats/Data/Seeds/
!Beyond-the-Stats/Data/Seeds/**

# FIFA rankings + national-team API sources
!Beyond-the-Stats/Data/National_Team_Data/all_team_rankings.json
!Beyond-the-Stats/Data/National_Team_Data/national_team_api_sources.json

dist-frontend/
scripts/__pycache__/
/public/
# Commit the Cloudflare Pages static site artifact so production can be
# updated even when the Actions deploy token is missing.
!Beyond-the-Stats/public/
!Beyond-the-Stats/public/**
