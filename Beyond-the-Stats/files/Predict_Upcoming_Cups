def find_latest_season_file_per_competition(raw_dir):
    latest = {}
    for root, _, files in os.walk(raw_dir):
        for name in files:
            if not name.endswith(".csv"):
                continue
            start_year = pm.parse_season_start_year(name)
            if start_year is None:
                continue
            full_path = os.path.join(root, name)
            rel_path = os.path.relpath(full_path, raw_dir)
            competition = competition_from_rel_path(rel_path)
            current = latest.get(competition)
            if current is None or start_year > current[0]:
                latest[competition] = (start_year, rel_path)
    return {competition: rel_path for competition, (_, rel_path) in latest.items()}


def fetch_json(url, headers=None, timeout=30):
    request = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        payload = response.read().decode("utf-8")
    return json.loads(payload)


def load_preseason_json(path):
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as file:
            payload = json.load(file)
    except Exception as exc:
        print(f"Preseason fallback: could not read {path}: {exc}")
        return {}
    return payload if isinstance(payload, dict) else {}


def apply_preseason_league_fallback_to_context(context):
    """Inject provisional 2026-27 league context when live season data is absent.

    This does not overwrite real trained team stats. It only adds league
    strength entries and a team->league hint list so upcoming cup fixtures
    involving not-yet-seen 2026-27 clubs can pass through to the existing
    unknown-team fallback path.
    """
    payload = load_preseason_json(PRESEASON_LEAGUE_FALLBACK_FILE)
    leagues = payload.get("leagues", {}) if isinstance(payload, dict) else {}
    if not isinstance(leagues, dict):
        return context

    league_strength = context.setdefault("league_strength", {})
    team_competition_map = context.setdefault("team_competition_map", {})
    preseason_known = set(context.get("preseason_known_teams", set()))
    preseason_team_league = context.setdefault("_preseason_team_league", {})

    for league, info in leagues.items():
        if not isinstance(info, dict):
            continue
        league = str(league).strip()
        if not league:
            continue
        try:
            strength = float(info.get("league_strength"))
        except (TypeError, ValueError):
            country = str(info.get("country", "")).strip()
            strength = uefa.get_country_strength(country) if country else None
        if strength is not None:
            league_strength.setdefault(league, strength)

        for team_name in info.get("teams", []) or []:
            team_name = str(team_name).strip()
            if not team_name:
                continue
            team_competition_map.setdefault(team_name, league)
            preseason_team_league[team_name] = league
            preseason_known.add(team_name)

    context["preseason_known_teams"] = preseason_known
    return context


def load_preseason_cup_fixtures(window_days, competition_name):
    """Return provisional preseason fixtures for API smoke tests/offseason gaps."""
    payload = load_preseason_json(PRESEASON_CUP_FIXTURES_FILE)
    fixtures = payload.get("fixtures", []) if isinstance(payload, dict) else []
    if not isinstance(fixtures, list):
        return pd.DataFrame()

    today = pd.Timestamp(datetime.now(UTC).date()).normalize()
    rows = []
    for fixture in fixtures:
        if not isinstance(fixture, dict):
            continue
        if str(fixture.get("competition", "")).strip() != competition_name:
            continue
        home_team = str(fixture.get("home_team", "")).strip()
        away_team = str(fixture.get("away_team", "")).strip()
        if not home_team or not away_team:
            continue

        days_from_today = fixture.get("days_from_today")
        if days_from_today is not None:
            try:
                match_date = today + pd.Timedelta(days=int(days_from_today))
            except (TypeError, ValueError):
                continue
        else:
            match_date = pd.to_datetime(fixture.get("match_date"), errors="coerce")
            if pd.isna(match_date):
                continue
            match_date = match_date.normalize()
            if match_date < today:
                continue

        rows.append(
            {
                "match_date": match_date,
                "match_datetime_utc": str(fixture.get("match_datetime_utc", "")).strip(),
                "match_datetime_et": str(fixture.get("match_datetime_et", "")).strip(),
                "competition": competition_name,
                "home_team": home_team,
                "away_team": away_team,
                "fixture_source": "preseason_fallback",
            }
        )

    frame = pd.DataFrame(rows)
    if frame.empty:
        return frame
    frame = frame.sort_values(["match_date", "home_team", "away_team"]).reset_index(drop=True)
    frame = filter_to_next_fixture_window(frame, window_days, f"Preseason fallback {competition_name}")
    print(f"Preseason fallback: Loaded {len(frame)} provisional fixtures for {competition_name}.")
    return frame


def validate_cup_api_endpoints(timeout=15):
    """Probe ESPN cup scoreboard endpoints and report whether each returns data.

    The upcoming-cups loader handles empty event lists gracefully, but a 400/404
    here means the espn_id itself is wrong and should be fixed. This helper is
    intentionally side-effect-free so it can be used by smoke tests.
    """
    statuses = []
    for cup_name, cup_data in sorted(CUP_COMPETITIONS.items(), key=lambda item: item[1]["priority"]):
        espn_id = cup_data.get("espn_id")
        url = ESPN_SCOREBOARD_API.format(espn_id=espn_id)
        status = {
            "cup": cup_name,
            "competition": cup_data.get("name", ""),
            "espn_id": espn_id,
            "ok": False,
            "http_status": None,
            "events": 0,
            "error": "",
        }
        try:
            data = fetch_json(url, timeout=timeout)
            status["http_status"] = 200
            status["events"] = len(data.get("events") or [])
            status["ok"] = True
        except urllib.error.HTTPError as exc:
            status["http_status"] = exc.code
            status["error"] = f"HTTP {exc.code}"
        except Exception as exc:
            status["error"] = str(exc)
        statuses.append(status)
    return statuses


def load_upcoming_matchweek_fixtures_from_csv_fallback(window_days, competition_name):
    today = pd.Timestamp(datetime.now(UTC).date())
    source = download_latest.fetch_source_dataframe()
    needed = {"Date", "Home", "Away", "HG", "AG"}
    if not needed.issubset(source.columns):
        print(f"CSV Fallback: Missing required columns {needed}. Skipping.")
        return pd.DataFrame()

    frame = source.copy()
    frame["match_date"] = pd.to_datetime(frame["Date"], dayfirst=False, format="mixed", errors="coerce").dt.normalize()
    frame = frame[frame["match_date"].notna()]
    frame = frame[frame["Home"].notna() & frame["Away"].notna()]

    # Upcoming fixtures are usually rows without final goals yet.
    frame = frame[frame["HG"].isna() & frame["AG"].isna()]
    frame = frame[frame["match_date"] >= today]
    if frame.empty:
        print("CSV Fallback: No upcoming fixtures found.")
        return pd.DataFrame()

    frame = frame.rename(columns={"Home": "home_team", "Away": "away_team"})
    frame["competition"] = competition_name # Set the correct competition name
    fixtures = frame[["match_date", "competition", "home_team", "away_team"]].copy()
    fixtures["match_datetime_et"] = None
    fixtures = fixtures.sort_values(["match_date", "home_team", "away_team"]).reset_index(drop=True)
    fixtures = filter_to_next_fixture_window(fixtures, window_days, f"CSV Fallback {competition_name}")
    print(f"CSV Fallback: Successfully filtered down to {len(fixtures)} fixtures.")
    return fixtures


def load_upcoming_matchweek_fixtures_from_espn(window_days, competition_name, espn_id, lookahead_days=365):
    today = pd.Timestamp(datetime.now(UTC).date())
    rows = []
    seen = set()

    print(f"Attempting to load fixtures for competition: {competition_name} (espn_id: {espn_id}) from ESPN...")

    debug_dir = os.path.join(PREDICTIONS_DIR, "espn_raw_debug")
    os.makedirs(debug_dir, exist_ok=True)

    for offset in range(0, max(1, lookahead_days + 1)):
        day = today + pd.Timedelta(days=offset)
        url = ESPN_SCOREBOARD_API.format(espn_id=espn_id) + f"?dates={day.strftime('%Y%m%d')}"
        try:
            data = fetch_json(url, timeout=30)
            # Save raw response for debug
            debug_file = os.path.join(debug_dir, f"{competition_name.replace('/', '_').replace(' ', '_')}_{day.strftime('%Y%m%d')}.json")
            with open(debug_file, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
            print(f"[DEBUG] Saved ESPN raw response to {debug_file}")
        except Exception as e:
            print(f"ESPN API Error for {day.date()}: {e}")
            continue

        events = data.get("events", [])
        if not isinstance(events, list):
            continue

        for event in events:
            event_date = pd.to_datetime(event.get("date"), utc=True, errors="coerce")
            if pd.isna(event_date):
                continue
            event_dt_et = event_date.tz_convert(EASTERN_TZ)
            match_date = event_dt_et.tz_localize(None).normalize()
            if match_date < today:
                continue

            competitions = event.get("competitions", [])
            if not competitions:
                continue

            comp0 = competitions[0] or {}

            status_state = (
                ((comp0.get("status") or {}).get("type") or {}).get("state", "")
            ).strip().lower()
            # Keep only not-started/scheduled matches.
            if status_state and status_state not in {"pre"}:
                continue

            competitors = comp0.get("competitors", [])
            home_team = ""
            away_team = ""
            for c in competitors:
                team_name = ((c.get("team") or {}).get("displayName") or "").strip()
                side = str(c.get("homeAway", "")).strip().lower()
                if side == "home":
                    home_team = team_name
                elif side == "away":
                    away_team = team_name
            if not home_team or not away_team:
                continue

            key = (match_date.strftime("%Y-%m-%d"), home_team, away_team)
            if key in seen:
                continue
            seen.add(key)
            rows.append(
                {
                    "match_date": match_date,
                    "match_datetime_et": event_dt_et.isoformat(),
                    "competition": competition_name, # Use the requested competition name
                    "home_team": home_team,
                    "away_team": away_team,
                }
            )

    fixtures = pd.DataFrame(rows)
    if fixtures.empty:
        return fixtures

    fixtures = fixtures.sort_values(["match_date", "home_team", "away_team"]).reset_index(drop=True)
    fixtures = filter_to_next_fixture_window(fixtures, window_days, f"ESPN {competition_name}")
    print(f"ESPN Loader: Successfully filtered down to {len(fixtures)} fixtures.")
    return fixtures


