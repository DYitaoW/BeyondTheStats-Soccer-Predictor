# ─────────────────────────────────────────────────────────────────────────────
# BeyondTheStats Backend Configuration — Apple M6 Mac Mini (16 GB Unified RAM)
# ─────────────────────────────────────────────────────────────────────────────
# This file is pre-configured and optimized specifically for an Apple Silicon
# Mac Mini (16 GB RAM) operating both as an always-on 24/7 backend server and
# as a shared daily workstation / multi-server host.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Web Server & Host Networking ──────────────────────────────────────────
# Bind to all interfaces so Cloudflare Tunnel (cloudflared) and LAN can reach it
HOST=0.0.0.0

# Port 8000 avoids conflicts with macOS ControlCenter/AirPlay Receiver (port 5000)
PORT=8000

# CORS origins allowed to access the API (website domain, localhost, and iOS app)
ALLOWED_ORIGINS=

# Secret token required to trigger administrative pipeline refreshes (/api/admin, /api/refresh)
# You can keep this generated secret or replace it with your own random hex string
MUTATION_API_TOKEN=

# Responses >= 1000 bytes are gzip-compressed to minimize bandwidth
GZIP_MINIMUM_SIZE=1000

# ── 2. Apple Push Notification service (APNs) & ActivityKit Live Activities ──
# 10-character Key ID from Apple Developer -> Certificates, Identifiers & Profiles -> Keys
APNS_KEY_ID=

# 10-character Team ID from Apple Developer (upper-right corner under your name)
APNS_TEAM_ID=

# Absolute path to your downloaded Apple .p8 authentication private key on the Mac Mini.
# Recommended location: Create a 'keys' folder in your user home directory (~/keys/)
APNS_AUTH_KEY_PATH=

# Your iOS app's Bundle Identifier
APNS_TOPIC=

# ActivityKit Live Activity Topic
APNS_LIVE_ACTIVITY_TOPIC=

# APNs Environment:
# 1 = Sandbox (for Xcode USB/Wi-Fi debug builds on physical device or simulator)
# 0 = Production (for TestFlight beta and App Store builds)
# NOTE: The backend will auto-fallback between Sandbox and Production if a token mismatch occurs!
APNS_USE_SANDBOX=1

# ── 3. Pipeline Scheduling & Execution ───────────────────────────────────────
# Enable the automated background pipeline system
PIPELINE_ENABLED=1

# 0 = Do NOT run full retrain on boot; use existing models (.pkl) from Output/ (starts in 2 seconds)
# 1 = Force full pipeline run immediately on startup
PIPELINE_RUN_ON_START=0
PIPELINE_FULL_RETRAIN_ON_START=0

# Daily pipeline run scheduled for 2:00 AM Eastern Time (when all European & MLS matches are finished)
PIPELINE_REFRESH_TIME=02:00
PIPELINE_TIMEZONE=America/New_York

# ── 4. Hardware Optimization for Apple M6 Mac Mini (16 GB RAM) ───────────────
# Hard RAM ceiling for the backend and data pipeline process group.
# On a 16 GB unified memory Mac running as a shared computer, 10.0 GB gives the pipeline
# peak throughput while reserving 6.0 GB for macOS system UI, window manager, and other apps.
BTS_MEMORY_LIMIT_GB=10.0

# CPU Core allocation for table simulation (Project_League_Table.py):
# 0 = Auto-detect CPU cores, automatically reserving 1 high-efficiency core exclusively
# for the live-score polling thread and incoming API requests so the server never stutters.
COMPETITION_WORKERS=0

# Future-games watcher poll frequency (checks for fixture schedule updates every 5 min)
WATCHER_INTERVAL=300

# Fixture lookahead window in days
PIPELINE_WINDOW_DAYS=365

# ── 5. macOS Apple Silicon Stability & Fork Safety ───────────────────────────
# MANDATORY on macOS: Disables unsafe Objective-C runtime fork hooks in Python multiprocessing
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Flushes Python stdout/stderr lines immediately for clean launchd / terminal logging
PYTHONUNBUFFERED=1

# ── 6. In-Memory Caching & Rate Limits ────────────────────────────────────────
# In-memory fast caching TTLs in seconds
CACHE_TTL_DEFAULT=120
CACHE_TTL_LONG=600
CACHE_TTL_LIVE=10

# API rate limits (120 calls per minute per IP)
API_RATE_LIMIT_PER_MINUTE=120
REDEEM_RATE_LIMIT_PER_MINUTE=10

# Prefer precomputed static predictions for instant < 10ms API responses
STATIC_PREDICTIONS=1
LOW_MEMORY_STATIC=1

# Prefer precomputed static predictions for instant < 10ms API responses
STATIC_PREDICTIONS=1
LOW_MEMORY_STATIC=1

