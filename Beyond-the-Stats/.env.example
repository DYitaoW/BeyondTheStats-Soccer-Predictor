# BeyondTheStats Backend Environment Variables Configuration Template
# Copy this file to .env in this directory (Beyond-the-Stats/.env) and fill in your values.

# ── Apple Push Notification service (APNs) & Live Activities ──────
# 10-character Key ID from Apple Developer -> Certificates, Identifiers & Profiles -> Keys
APNS_KEY_ID=

# 10-character Team ID from Apple Developer (upper-right corner under your name)
APNS_TEAM_ID=

# Absolute path to the downloaded .p8 authentication private key file
# Windows example: C:/Users/dylan/keys/AuthKey_XXXXXXXXXX.p8
# Linux/macOS example: /home/dylan/keys/AuthKey_XXXXXXXXXX.p8
APNS_AUTH_KEY_PATH=

# Your iOS app's Bundle Identifier (must match Xcode Target Bundle Identifier)
APNS_TOPIC=Yitao.BeyondTheStatsApp

# Live Activity topic (defaults to <APNS_TOPIC>.push-type.liveactivity)
APNS_LIVE_ACTIVITY_TOPIC=Yitao.BeyondTheStatsApp.push-type.liveactivity

# APNs Environment:
# Set to 1 (true) for Xcode USB/Wi-Fi debug builds on physical device (Sandbox)
# Set to 0 (false) for TestFlight and App Store builds (Production)
APNS_USE_SANDBOX=1

# ── Server & Security ──────────────────────────────────────────────
# Secret token required for write-capable endpoints (/api/admin, /api/debug)
MUTATION_API_TOKEN=

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# GZip compression threshold in bytes (responses >= this size are compressed)
GZIP_MINIMUM_SIZE=1000

# ── Pipeline Startup ──────────────────────────────────────────────
# 0 = do NOT run the full daily pipeline on server restart (default)
# 1 = run full pipeline immediately when backend boots
PIPELINE_RUN_ON_START=0
PIPELINE_ENABLED=1

