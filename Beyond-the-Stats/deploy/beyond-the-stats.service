[Unit]
Description=Beyond the Score backend (Flask + daily pipeline scheduler)
Documentation=https://github.com/anomalyco/opencode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dylan
Group=dylan
WorkingDirectory=/home/dylan/bts/Beyond-the-Stats
Environment="PATH=/home/dylan/bts/Beyond-the-Stats/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="FOOTBALL_DATA_API_TOKEN=//"
Environment="ALLOWED_ORIGINS=https://beyondthestatsapp.com,https://www.beyondthestatsapp.com,https://api.beyondthestatsapp.com,https://beyond-the-stats.pages.dev,http://localhost:8099,http://localhost:5000"
# Full daily pipeline (download/train/upcoming/tables/cups). Set BTS_TABLES_ONLY=1
# only to shorten a run to projected tables + cup refresh.
Environment="BTS_TABLES_ONLY=0"
# Keep football-data.org on the per-minute budget (no fixed inter-request sleep).
# A leftover FOOTBALL_DATA_API_DELAY_SECONDS=120 from older deploys can push the
# full pipeline past the backend's 6h kill switch.
Environment="FOOTBALL_DATA_API_DELAY_SECONDS=0"
# Match MemoryMax / --memory-limit-gb so competition-worker auto-sizing uses
# the 14 GB ceiling instead of the host's larger physical RAM.
Environment="BTS_MEMORY_LIMIT_GB=14"
# Keep past_games.json forever (0). Set e.g. 365 to prune the display archive
# only; past_games_journal.jsonl is always append-only.
Environment="BTS_PAST_GAMES_RETENTION_DAYS=0"
# Optional (off by default): BTS_SKIP_UNCHANGED_PROJECTIONS=1, BTS_CUP_SKIP_UNCHANGED=1
ExecStart=/home/dylan/bts/Beyond-the-Stats/.venv/bin/python main/run_backend.py --memory-limit-gb 14 --no-watcher --national-window-days 60 --port 8099
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
KillSignal=SIGTERM
MemoryMax=14G
CPUQuota=800%
OOMPolicy=stop
OOMScoreAdjust=-100
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beyond-the-stats

[Install]
WantedBy=multi-user.target
